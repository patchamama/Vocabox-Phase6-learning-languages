SECRET_KEY=change-this-to-a-secure-random-string
DATABASE_URL=sqlite:///./vocabox.db
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PORT=9009
# YouTube subtitle import — proxy tuning (optional, sane defaults)
# Outbound proxy used by yt-dlp and youtube-transcript-api. Frontend admin
# can override this at runtime; the DB override always wins over this value.
# YOUTUBE_PROXY_URL=http://user:pass@host:port/
# Extra attempts via the proxy after the first try (each retry usually gets a
# fresh egress IP from rotating proxies). Default 3 → up to 4 total attempts.
# YT_PROXY_RETRIES=3
# Seconds to sleep between proxy retries. Default 0.5.
# YT_PROXY_RETRY_SLEEP=0.5
# If every proxy attempt is blocked, fall back to the server's own IP for one
# last try. Default true.
# YT_FALLBACK_DIRECT=true
# Seconds between consecutive videos during batch import to reduce rate-limit
# / IP-block triggers. Default 0.5.
# YT_INTER_VIDEO_DELAY=0.5
